{
  "name": "@onetodone/toollock",
  "version": "0.0.0",
  "description": "A lockfile for MCP tool and prompt definitions.",
  "type": "module",
  "bin": {
    "toollock": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:hash-determinism": "tsx scripts/check-hash-determinism.ts",
    "collect": "tsx scripts/run-collector.ts",
    "snapshot:registry": "tsx scripts/snapshot-registry.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "canonicalize": "^4.0.0",
    "gpt-tokenizer": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^4.5.4"
  }
}
